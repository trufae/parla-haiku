+            Self::Ppp => 0x17,
+            Self::Loopback => 0x18,
+            Self::Slip => 0x1c,
+            Self::GenericModem => 0x30,
+            Self::Tunnel => 0x83,
+            Self::Bridge => 0xd1,
+            _ => u32::MAX,
+        }
+    }
