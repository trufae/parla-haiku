+//! Poll interface state on Haiku, where the BSD routing socket API is absent.
+use n0_future::task::{self, AbortOnDropHandle};
+use tokio::sync::mpsc;
+use super::actor::NetworkMessage;
+
+pub type Error = std::io::Error;
+
+#[derive(Debug)]
+pub(super) struct RouteMonitor {
+    _task: AbortOnDropHandle<()>,
+}
+impl RouteMonitor {
+    pub(super) fn new(sender: mpsc::Sender<NetworkMessage>) -> Result<Self, Error> {
+        let task = task::spawn(async move {
+            let mut timer = tokio::time::interval(std::time::Duration::from_secs(5));
+            loop {
+                timer.tick().await;
+                // The actor compares complete interface snapshots and suppresses
+                // callbacks when nothing changed. No route or address is invented.
+                if sender.send(NetworkMessage::Change).await.is_err() { break; }
+            }
+        });
+        Ok(Self { _task: AbortOnDropHandle::new(task) })
+    }
+}
+pub(super) fn is_interesting_interface(_name: &str) -> bool { true }
